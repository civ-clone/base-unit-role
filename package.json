{
  "name": "@civ-clone/base-unit-role",
  "version": "0.1.0",
  "description": "Unit roles: what a unit type is for (attack, defend, transport, settle…), declared per game with UnitRoles rules.",
  "repository": "git@github.com:civ-clone/base-unit-role.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "files": [
    "*.js",
    "*.d.ts",
    "*.js.map",
    "Rules/*.js",
    "Rules/*.d.ts",
    "Rules/*.js.map",
    "*.ts",
    "Rules/*.ts"
  ],
  "scripts": {
    "bench": "ts-mocha ./bench/*.ts",
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@types/chai": "^4.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.0.0",
    "chai": "^4.0.0",
    "mocha": "^10.0.0",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@civ-clone/core-rule": "^0.1.9",
    "@civ-clone/core-unit": "^0.1.31"
  }
}
